WorldInfo {
  title "GuardianBot test world w16_maze (seed 16, start maze)"
  info [
    "PeraBots 2026 Final Round - University Category"
    "Arena 2.44 m x 3.66 m. Section 3 rebuilt from rulebook Figure 1."
    "Robot: GuardianBot v2 (HC-SR04 + Sharp IR build)"
  ]
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 0.8 ]
    }
    ContactProperties {
      material1 "default"
      material2 "tire"
      coulombFriction [ 1.0 ]
    }
    ContactProperties {
      material1 "default"
      material2 "caster"
      coulombFriction [ 0.05 ]
    }
    ContactProperties {
      material1 "default"
      material2 "chassis"
      coulombFriction [ 0.15 ]
    }
  ]
}
